# Application Settings
PROJECT_NAME="BarRaiser AI Interviewer"
DEBUG=True
API_V1_PREFIX="/api"

# Database Configuration (Defaults to local SQLite)
DATABASE_URL="sqlite+aiosqlite:///./interview_prep.db"

# LLM Provider Configuration
# Options: "gemini", "openai", "mock" (mock runs locally with zero API key required)
LLM_PROVIDER="mock"

# API Keys (Set when ready)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Model Names
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_MODEL="gpt-4o-mini"
